# Copy this file to .env, then paste your personal API values after the equals signs.
TIINGO_API_KEY=
FRED_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Autonomous research remains disabled unless explicitly enabled.
QLT_AUTONOMOUS_ENABLED=false

# BTCUSD defaults to the frozen btc_pre2024_v1 campaign with a 2024-01-01
# permanent holdout. To begin a genuinely new campaign, set ALL of these to
# explicit new values. Do not move the holdout under the old campaign id.
# QLT_CRYPTO_CAMPAIGN_ID=btc_2026_v1
# QLT_CRYPTO_HOLDOUT_START=2026-01-01
# QLT_CRYPTO_CAMPAIGN_STARTS=2018-01-01,2020-01-01,2022-01-01
# QLT_CRYPTO_CAMPAIGN_ENDS=2026-08-29

# SEC fair-access requires a real contact identity (never a secret)
SEC_USER_AGENT=quant-loop-trader you@example.com